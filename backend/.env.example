# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expense_voucher_db
DB_USER=postgres
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Resend email OTP delivery. Use a verified sender in production.
RESEND_API_KEY=
EMAIL_FROM=

# Initial Admin setup. Keep actual values in backend/.env only.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_NEW_PASSWORD=

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
